[Unit]
Description=Lego Alma service
After=network.target

[Service]
# Service file configured for the Raspberry Pi user and project path
# Updated to use the reported Pi user and paths
User=legoalma
WorkingDirectory=/home/legoalma
ExecStart=/home/legoalma/pi_deploy/.venv_pi/bin/python /home/legoalma/la_main.py
Restart=always

[Install]
WantedBy=multi-user.target
